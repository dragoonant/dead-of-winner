{
  "kind": "crossroads",
  "id": "xr.david-garcia",
  "name": "David Garcia",
  "survivor": "sv.david-garcia",
  "mature": false,
  "trigger": {
    "point": "action.search",
    "when": {
      "all": [
        {
          "test": "survivorIs",
          "subject": "survivor",
          "value": "sv.david-garcia"
        },
        {
          "not": {
            "test": "seatIsExiled",
            "subject": "seat"
          }
        }
      ]
    }
  },
  "options": [
    {
      "id": "accuse",
      "effect": [
        {
          "op": "vote",
          "scope": {
            "who": "allSeats"
          },
          "options": [
            {
              "id": "yes",
              "label": "Exile them",
              "effect": [
                {
                  "op": "exile",
                  "scope": {
                    "who": "chosen",
                    "chooser": "activeSeat",
                    "filter": {
                      "all": [
                        {
                          "test": "survivorsAtLeast",
                          "subject": "seat",
                          "location": "colony",
                          "value": 1
                        },
                        {
                          "not": {
                            "test": "isActiveSeat",
                            "subject": "seat"
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "id": "no",
              "label": "Let it go",
              "effect": [
                {
                  "op": "morale",
                  "value": 0
                }
              ]
            }
          ]
        }
      ],
      "vote": true
    },
    {
      "id": "retract",
      "effect": [
        {
          "op": "morale",
          "value": 0
        }
      ]
    }
  ],
  "text": {
    "trigger": "David searches.",
    "vignette": "David has found the thing in the ledgers that does not add up, and he has a very good idea whose handwriting it is. He is ready to say so in front of everybody.",
    "options": {
      "accuse": "Name the thief and put the exile of another player at the colony to a vote.",
      "retract": "Realise there was a decimal off. Nothing happens."
    }
  },
  "sources": {
    "trigger": "BGG crossroads-v1.1",
    "options": "BGG crossroads-v1.1",
    "mature": "BGG crossroads-v1.1 (verify)"
  },
  "status": "draft",
  "notes": "src: Crossroad_cards_v1.1 card #66. "
}
