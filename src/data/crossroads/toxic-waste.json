{
  "kind": "crossroads",
  "id": "xr.toxic-waste",
  "name": "Toxic Waste",
  "mature": false,
  "trigger": {
    "point": "action.any",
    "when": {
      "test": "survivorsAtLeast",
      "subject": "seat",
      "location": "colony",
      "value": 1
    }
  },
  "options": [
    {
      "id": "up",
      "vote": true,
      "effect": [
        {
          "op": "vote",
          "scope": {
            "who": "allSeats",
            "filter": {
              "test": "survivorsAtLeast",
              "subject": "seat",
              "location": "colony",
              "value": 1
            }
          },
          "options": [
            {
              "id": "yes",
              "label": "Clean it up by hand",
              "effect": [
                {
                  "code": "crossroads.rule.eachSeatPick",
                  "params": {
                    "where": "colony",
                    "then": [
                      {
                        "op": "wound",
                        "count": 1,
                        "kind": "frostbite",
                        "scope": {
                          "who": "allSurvivors",
                          "filter": {
                            "test": "survivorIs",
                            "subject": "survivor",
                            "value": "$pick"
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "no",
              "label": "Dump the cleanup in the waste",
              "effect": [
                {
                  "code": "crossroads.rule.recoverRemoved",
                  "params": {
                    "symbol": "fuel",
                    "count": "all",
                    "to": "waste"
                  }
                },
                {
                  "code": "crossroads.rule.recoverRemoved",
                  "params": {
                    "symbol": "medicine",
                    "count": "all",
                    "to": "waste"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "down",
      "vote": true,
      "effect": [
        {
          "op": "vote",
          "scope": {
            "who": "allSeats",
            "filter": {
              "test": "survivorsAtLeast",
              "subject": "seat",
              "location": "colony",
              "value": 1
            }
          },
          "options": [
            {
              "id": "yes",
              "label": "Clean it up by hand",
              "effect": [
                {
                  "code": "crossroads.rule.eachSeatPick",
                  "params": {
                    "where": "colony",
                    "then": [
                      {
                        "op": "wound",
                        "count": 1,
                        "kind": "frostbite",
                        "scope": {
                          "who": "allSurvivors",
                          "filter": {
                            "test": "survivorIs",
                            "subject": "survivor",
                            "value": "$pick"
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "no",
              "label": "Dump the cleanup in the waste",
              "effect": [
                {
                  "code": "crossroads.rule.recoverRemoved",
                  "params": {
                    "symbol": "fuel",
                    "count": "all",
                    "to": "waste"
                  }
                },
                {
                  "code": "crossroads.rule.recoverRemoved",
                  "params": {
                    "symbol": "medicine",
                    "count": "all",
                    "to": "waste"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "text": {
    "trigger": "A player has a survivor at the colony.",
    "vignette": "A leaking barrel by the back fence has been seeping into the ground for days, and it smells of old engines and old pills. Someone has to go out into the cold to dig the poison out, or the colony can live with whatever ends up in the heap.",
    "options": {
      "up": "Thumbs up: every player puts a frostbite wound on one of their survivors at the colony (their pick).",
      "down": "Thumbs down: every Fuel and Medicine card that has left the game is added to the waste pile."
    }
  },
  "sources": {
    "trigger": "BGG crossroads-v1.1 card 33",
    "options": "BGG crossroads-v1.1 card 33"
  },
  "status": "draft",
  "notes": "src: Crossroad_cards_v1.1.xlsx.txt card #33"
}
