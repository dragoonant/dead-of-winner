      ]
    },
    {
      "id": "down",
      "vote": true,
      "effect": [
        {
          "op": "vote",
          "scope": {
            "who": "allSeats",
            "filter": {
              "test": "survivorsAtLeast",
              "subject": "seat",
              "location": "colony",
              "value": 1
            }
          },
          "options": [
            {
              "id": "yes",
              "label": "Search for her",
              "effect": [
                {
                  "code": "crossroads.missing-child.watch"
                }
              ]
            },
            {
              "id": "no",
              "label": "Give up the hunt",
              "effect": [
                {
                  "op": "morale",
                  "value": -1
                },
                {
                  "op": "removeHelpless",
                  "count": 1,
                  "location": "colony",
                  "value": "noMorale"
                }
              ]
