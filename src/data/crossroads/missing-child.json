  "text": {
    "trigger": "The colony holds at least one helpless survivor.",
    "vignette": "A mother is combing the yard calling a name, and nobody can say where her daughter went. All anyone knows is that the south wall is low and the land past it is full of the dead.",
    "options": {
      "up": "Thumbs up: send people out. If a search is made at every location outside the colony between now and the end of next round, morale rises by 1; otherwise morale falls by 1 and a helpless survivor leaves the colony.",
      "down": "Thumbs down: give up. Morale falls by 1 and a helpless survivor leaves the colony."
    }
  },
  "sources": {
