{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dead-of-winner/schemas/secret-objective.json",
  "title": "Secret, betrayal or exiled objective (spec 20 §3.8; ObjectiveDescriptor kinds secret, betrayal, exiled)",
  "type": "object",
  "required": ["kind", "id", "name", "type", "requiresMain", "complete", "text", "sources", "status"],
  "properties": {
    "kind": { "const": "secretObjective" },
    "id": { "$ref": "common.json#/$defs/secretObjectiveId" },
    "name": { "type": "string", "minLength": 1 },
    "type": { "enum": ["secret", "betrayal", "exiled"], "description": "same spelling as ObjectiveDescriptor.kind (hooks.ts) and the id prefix; the setup event SecretObjectiveDealt.kind spells 'secret' as 'standard' (21 §9)" },
    "ai": {
      "type": "object",
      "description": "betrayer hint read by 40 §7.1; expected on every betrayal record (V-10 warns), allowed on the others",
      "required": ["lever"],
      "properties": {
        "lever": {
          "anyOf": [
            { "enum": ["moraleZero", "killSurvivors", "zombiesAtColony", "exileOthers", "starve", "custom"] },
            { "type": "string", "pattern": "^hoard:(weapon|fuel|education|food|medicine|tool|survivor)$" }
          ]
        }
      },
      "additionalProperties": false
    },
    "code": { "type": "string", "pattern": "^S[0-9]{2}$", "description": "betrayal story section (R p18-19)" },
    "requiresMain": { "type": "boolean", "description": "the main objective must also be complete (most standard cards, R p3)" },
    "requiresOriginal": { "type": "boolean", "description": "exiled only: the seat's original secret objective must also be complete; default false = the exiled card replaces it (RULING, 20 §3.8)" },
    "counters": { "$ref": "common.json#/$defs/counters" },
    "complete": { "$ref": "common.json#/$defs/conditionNode", "description": "evaluated for the holder seat at game end (E.12); subject seat = holder" },
    "triggers": { "type": "array", "items": { "$ref": "common.json#/$defs/triggerDef" } },
    "setup": { "type": "array", "items": { "$ref": "common.json#/$defs/effectNode" }, "description": "applied when dealt (or when drawn, for exiled cards)" },
    "text": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": { "$ref": "common.json#/$defs/prose", "description": "what the holder must achieve, our words" },
        "story": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": false
    },
    "sources": { "$ref": "common.json#/$defs/sources" },
    "status": { "$ref": "common.json#/$defs/status" },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "$ref": "common.json#/$defs/slug" } }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "type": "object", "properties": { "type": { "const": "secret" } } }, "then": { "type": "object", "properties": { "id": { "type": "string", "pattern": "^obj\\.secret\\." } } } },
    { "if": { "type": "object", "properties": { "type": { "const": "betrayal" } } }, "then": { "type": "object", "properties": { "id": { "type": "string", "pattern": "^obj\\.betrayal\\." } }, "required": ["code"] } },
    { "if": { "type": "object", "properties": { "type": { "const": "exiled" } } }, "then": { "type": "object", "properties": { "id": { "type": "string", "pattern": "^obj\\.exiled\\." } } } },
    { "if": { "type": "object", "properties": { "type": { "not": { "const": "exiled" } } } }, "then": { "not": { "type": "object", "required": ["requiresOriginal"] } } }
  ]
}
